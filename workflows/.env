# Committed on purpose. This is not a secret.
#
# The Hatchet dev image has auth compiled out and ships one fixed, non-expiring
# worker token, scoped to the default tenant. It is identical on every
# auth-disabled instance, so there is nothing to mint and nothing to rotate.
HATCHET_CLIENT_TOKEN=eyJhbGciOiJFUzI1NiIsICJraWQiOiJMR2NRSFEifQ..FUKNYefFd5YX7fasi1rPH5f2b36KW6D5qB-u-jNpQFdZTm3cgQTpCbo_4TvcJ11LdAktJdR56fcSzsiENlkMxQ
HATCHET_CLIENT_TLS_STRATEGY=none

# The token hardcodes a broadcast address of localhost:7077, and we publish
# gRPC on 7077, so this just restates what the token already says. Kept
# explicit because it documents where host workers dial.
# (The worker container overrides this to hatchet:7077 — inside a container,
# localhost is the container itself.)
HATCHET_CLIENT_HOST_PORT=localhost:7077
